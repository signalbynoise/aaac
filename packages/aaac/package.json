{
  "name": "@ludecker/aaac",
  "version": "1.2.7",
  "description": "Agentic Architecture as Code (AAAC) — installable Cursor agent framework",
  "type": "module",
  "license": "MIT",
  "author": "Hans-Erik Lydecker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriklydecker/ludecker.git",
    "directory": "packages/aaac"
  },
  "homepage": "https://ludecker.com/guide/install-aaac",
  "bugs": {
    "url": "https://github.com/eriklydecker/ludecker/issues"
  },
  "keywords": [
    "aaac",
    "agentic-architecture",
    "cursor",
    "ai-agents",
    "skills",
    "commands"
  ],
  "bin": {
    "aaac": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/cli.mjs",
    "./install": "./src/lib/install.mjs",
    "./run-engine/agent-progress-contract": "./src/run-engine/agent-progress-contract.mjs",
    "./run-engine/reconcile-run-status": "./src/run-engine/reconcile-run-status.mjs",
    "./run-engine/swarm-agent-specs": "./src/run-engine/swarm-agent-specs.mjs",
    "./run-engine/expected-agent-specs": "./src/run-engine/expected-agent-specs.mjs",
    "./run-engine/swarm-telemetry": "./src/run-engine/swarm-telemetry.mjs",
    "./run-engine/estimate-token-cost": "./src/run-engine/estimate-token-cost.mjs",
    "./run-engine/load-model-pricing": "./src/run-engine/load-model-pricing.mjs"
  },
  "files": [
    "src/",
    "templates/"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "node --test tests/log.test.mjs",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm exec playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/better-sqlite3": "^7.6.13",
    "vitest": "^3.2.4",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ludecker/agentic-bridge": "workspace:^",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^12.11.1",
    "usearch": "^2.26.0",
    "yaml": "^2.8.0"
  }
}

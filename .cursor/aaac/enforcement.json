{
  "version": 4,
  "description": "AAAC runtime enforcement — SSOT for hooks and run engine",
  "agent_separation": {
    "parent_may_assess": false,
    "parent_may_edit_prod": false,
    "description": "Parent orchestrator must not assess or edit production code. Launch Task subagents; parent merges outputs only.",
    "orchestrator_may": [
      "dispatch",
      "merge_subagent_outputs",
      "advance_phase",
      "user_communication"
    ],
    "orchestrator_may_not": [
      "score_confidence",
      "pass_gates",
      "investigate",
      "plan",
      "verify",
      "review",
      "root_cause_synthesis",
      "report_without_swarm",
      "edit_prod_code"
    ],
    "editor_delegate_phases": [
      "execute",
      "debt_sweep"
    ],
    "required_execute_agent_spec": "code-author"
  },
  "edit_phases": [
    "execute",
    "debt_sweep",
    "test_execute",
    "sync_inventory",
    "persist",
    "write"
  ],
  "artifact_write_phases": [
    "campaign_init",
    "scan",
    "check_swarm",
    "plan_waves",
    "satisfaction_gate"
  ],
  "mutating_verbs": [
    "create",
    "update",
    "fix"
  ],
  "phase_edit_scopes": {
    "execute": {
      "deny_test_paths": true
    },
    "test_execute": {
      "test_paths_only": true
    }
  },
  "verify_verbs": [
    "create",
    "update",
    "fix"
  ],
  "swarm_min_agents": {
    "discover": 4,
    "investigate_lite": 3,
    "plan": 2,
    "validate": 3,
    "impact_analysis": 2,
    "dependency_graph": 2,
    "fitness_functions": 3,
    "rollback": 2,
    "root_cause": 2,
    "check_swarm": 3,
    "investigate_swarm": 7,
    "research_swarm": 6,
    "test_execute": 1,
    "verify": 3,
    "verify_fix": 3,
    "review_swarm": 3,
    "report": 2,
    "execute": 1
  },
  "swarm_min_agents_by_command": {
    "remediate-app": {
      "check_swarm": 7
    }
  },
  "phase_artifacts_by_verb": {
    "check": {
      "discover": [
        "artifacts/discover_brief.yaml"
      ]
    }
  },
  "phase_artifact_aliases": {
    "artifacts/impact.yaml": [
      "artifacts/impact_analysis.yaml",
      "artifacts/impact-analysis.yaml"
    ],
    "artifacts/fitness.yaml": [
      "artifacts/fitness_functions.yaml",
      "artifacts/fitness-functions.yaml"
    ]
  },
  "phase_artifacts": {
    "discover": [
      "artifacts/discover_brief.yaml",
      "artifacts/discovery-brief.md"
    ],
    "investigate_lite": [
      "artifacts/investigation_lite.yaml"
    ],
    "investigate_swarm": [
      "artifacts/investigation.md"
    ],
    "root_cause": [
      "artifacts/root_cause.yaml"
    ],
    "plan": [
      "artifacts/plan.yaml"
    ],
    "validate": [
      "artifacts/validate.yaml"
    ],
    "impact_analysis": [
      "artifacts/impact.yaml"
    ],
    "dependency_graph": [
      "artifacts/dependency_graph.yaml"
    ],
    "fitness_functions": [
      "artifacts/fitness.yaml"
    ],
    "rollback": [
      "artifacts/rollback.yaml"
    ],
    "test_execute": [
      "artifacts/test_plan.yaml"
    ],
    "verify": [
      "artifacts/verify.yaml"
    ],
    "review_swarm": [
      "artifacts/review.yaml"
    ],
    "report": [
      "artifacts/report.md"
    ],
    "execute": [
      "artifacts/execute_summary.yaml"
    ]
  },
  "allowed_path_prefixes": {
    "run_artifacts": [
      ".cursor/aaac/state/runs/",
      "aaac/state/runs/"
    ],
    "campaign_artifacts": [
      ".cursor/aaac/state/campaigns/",
      "aaac/state/campaigns/"
    ]
  },
  "remediation_gate": {
    "script": "verify-remediation-iteration.mjs",
    "remediator_gate_script": "remediator-gate.mjs",
    "debt_sweep_script": "debt-sweep-gate.mjs",
    "satisfaction_loop_script": "satisfaction-loop-gate.mjs",
    "repair_fallow_start_script": "repair-fallow-start-baseline.mjs",
    "bootstrap_autonomous_script": "bootstrap-autonomous.mjs",
    "runner_script": "remediation-runner.mjs",
    "runner_daemon_script": "remediation-runner-daemon.sh",
    "runner_health_script": "runner-health-check.mjs",
    "plan_waves_script": "plan-waves-from-queue.mjs",
    "validate_script": "validate-campaign-complete.mjs",
    "baseline_script": "capture-verify-baseline.mjs",
    "wave_snapshot_script": "capture-wave-snapshot.mjs",
    "classify_fallow_script": "classify-fallow-issues.mjs",
    "record_fallow_fp_script": "record-fallow-fp.mjs",
    "fallow_fp_rules": "fallow-fp-rules.json",
    "classify_script": "classify-verify-failure.mjs",
    "dispatch_rules": "dispatch-rules.json",
    "wave_mode": "wave",
    "debt_mode": "debt",
    "wave_gate_mode": "regression",
    "debt_gate_mode": "strict",
    "campaign_artifact": "artifacts/campaign.json",
    "exit_codes": {
      "promote": 0,
      "block": 1,
      "runtime_error": 2,
      "remediate": 3
    },
    "invariants": {
      "exit_3_is_continue": true,
      "never_block_campaign_on_wave_exit_3": true,
      "satisfaction_exit_3_is_continue_loop": true,
      "fallow_start_baseline_immutable": true,
      "validate_before_report": true
    }
  },
  "phase_artifacts_remediate": {
    "campaign_init": [
      "artifacts/campaign.json",
      "artifacts/verify_baseline.json"
    ],
    "scan": [
      "artifacts/fallow_scan.json",
      "artifacts/fallow_dupes.json",
      "artifacts/fallow_health.json",
      "artifacts/fallow_scan_bundle.json",
      "artifacts/fallow_classification.json"
    ],
    "check_swarm": [
      "artifacts/check_synthesis.md",
      "artifacts/dispatch-queue.yaml",
      "artifacts/check_app_validate.yaml",
      "artifacts/check_architecture_fitness.yaml",
      "artifacts/protected_paths.yaml",
      "artifacts/check_swarm_merge.json"
    ],
    "plan_waves": [
      "artifacts/plan_waves.yaml"
    ],
    "execute": [
      "artifacts/execute_waves.yaml"
    ],
    "debt_sweep": [
      "artifacts/debt_sweep.json",
      "artifacts/verify_debt.json"
    ],
    "satisfaction_gate": [
      "artifacts/satisfaction.json",
      "artifacts/satisfaction_loop_gate.json"
    ],
    "report": [
      "artifacts/report.md"
    ]
  },
  "fix_commands": [
    "fix-module",
    "fix-bug",
    "module-fix",
    "bug-fix"
  ]
}
